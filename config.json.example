{
  "bambu_cloud": {
    "account": "your_email@example.com",
    "password": "your_password",
    "region": "china"
  },
  "printer": {
    "target_serial": "03900D6A1521014",
    "printer_ip": "192.168.3.231",
    "access_code": ""
  },
  "detection": {
    "model_type": "yolov5",
    "model_engine": "models/yolov5_failure_416.engine",
    "confidence_threshold": 0.30,
    "consecutive_hits": 6,
    "target_classes": ["spaghetti", "error"]
  },
  "safety": {
    "dry_run": true,
    "action": "pause",
    "cooldown_seconds": 180
  },
  "storage": {
    "snapshots_dir": "snapshots",
    "logs_dir": "logs"
  }
}
